{
    "compilerOptions": {
        "jsx": "react-native",
        "target": "es2022",
        "checkJs": true,
        "maxNodeModuleJsDepth": 0,
        "strict": true,
        "resolveJsonModule": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "baseUrl": "src",
        "types": [
            "react",
            "react-native",
            "jest",
            "node"
        ],
        "paths": {
            "Ressources/*": [
                "../res/*"
            ]
        },
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": [
        "src",
        "./App.js",
        "./__tests__"
    ],
    "exclude": [
        "res",
        "node_modules"
    ]
}
