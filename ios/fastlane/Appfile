app_identifier(ENV.fetch("APP_IDENTIFIER")) # The bundle identifier of your app
apple_id(ENV.fetch("APPLE_ID")) # Your Apple Developer Portal username

itc_team_id(ENV.fetch("ITC_TEAM_ID")) # App Store Connect Team ID
team_id(ENV.fetch("TEAM_ID")) # Developer Portal Team ID

